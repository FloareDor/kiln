# Shared image for the gateway and the control plane.
#
# Both are plain Go network services with no GPU and no Python, so they get a
# distroless base: no shell, no package manager, nothing to exploit, and an image
# small enough that a rolling update is not gated on pulling it.

ARG GO_VERSION=1.27.4

FROM golang:${GO_VERSION} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGET=gateway
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/app ./cmd/${TARGET}

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/app /app
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/app"]
